# Copy this file to .env and fill in the real values.
# .env is gitignored — the credentials below must never be committed.

# ── ZeptoMail SMTP ───────────────────────────────────────────────────────
# Take these from ZeptoMail console → Mail Agents → your agent → SMTP.
# Use smtp.zeptomail.in for an India data-centre account, smtp.zeptomail.com
# otherwise. The username is literally "emailapikey"; the password is the
# send-mail token that starts with "Zoho-enczapikey ".
#
# Port: 587 works from a laptop. It does NOT work from the DigitalOcean
# droplet -- DO blocks outbound 25, 465 and 587, so a send there just times
# out after EMAIL_TIMEOUT. ZeptoMail also listens on 2525, which DO leaves
# open, so the server's own .env uses EMAIL_PORT=2525 with STARTTLS.
EMAIL_HOST=smtp.zeptomail.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=Zoho-enczapikey PASTE_THE_SEND_MAIL_TOKEN_HERE

# Must sit on a domain verified in ZeptoMail, or every send is rejected.
DEFAULT_FROM_EMAIL=ENpower Skill Lab <noreply@yourverifieddomain.com>

# Seconds to wait on the SMTP server before giving up.
EMAIL_TIMEOUT=20

# Roles that are never emailed. Students and Parents receive system-generated
# login IDs handed over by the school, so no credential mail goes to them.
EMAIL_SUPPRESSED_ROLES=STUDENT,PARENT

# Absolute base URL used for links inside emails.
SITE_URL=https://enpower.techinfinity.link

# ── Local development ────────────────────────────────────────────────────
# To print emails to the terminal instead of sending them:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Host configuration ───────────────────────────────────────────────────
# These have working defaults for the DigitalOcean droplet. Set them on any
# other host.

# DEBUG must be False anywhere the site is reachable from the internet.
DEBUG=False

# Generate a fresh one per host: python -c "from django.core.management.utils
# import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Extra hostnames and origins, comma separated. Railway's own hostname is
# picked up automatically from RAILWAY_PUBLIC_DOMAIN.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Set False where nginx or a CDN serves /media/ (the droplet does).
SERVE_MEDIA=True

# ── Storage ──────────────────────────────────────────────────────────────
# A container filesystem is wiped on every deploy. Both of these must point at
# a mounted volume there, or the database and every uploaded logo and photo are
# lost on each push.
#
# DATABASE_URL takes precedence over SQLITE_PATH when both are set. Railway
# provides DATABASE_URL automatically once a Postgres service is attached.
# DATABASE_URL=
# SQLITE_PATH=/data/db.sqlite3
# MEDIA_ROOT=/data/media

# How long a password reset link stays valid, in seconds (default 24 hours).
PASSWORD_RESET_TIMEOUT=86400
